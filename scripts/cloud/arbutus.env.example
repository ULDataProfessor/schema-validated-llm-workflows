# Copy this file to .arbutus.env at the repository root, then fill in values
# returned by `openstack image list`, `openstack flavor list`, and
# `openstack network list` after sourcing your private Arbutus OpenRC file.
# Never commit the copied file or an OpenRC file.

ARBUTUS_VM_NAME=pydantic-benchmark-runner
ARBUTUS_IMAGE=
ARBUTUS_FLAVOR=
ARBUTUS_NETWORK=
ARBUTUS_KEY_NAME=

# Restrict SSH to your current public IP address, for example 203.0.113.7/32.
ARBUTUS_SSH_CIDR=

# Set to 1 only when the VM should receive a public floating IP. Its network
# name varies by project; leave it blank until confirmed with `openstack network list`.
ARBUTUS_ASSIGN_FLOATING_IP=1
ARBUTUS_FLOATING_NETWORK=

# Optional: a local cloud-init YAML file. Do not put secrets in this file.
# For a supported Ubuntu image, this repository provides:
# scripts/cloud/cloud-init-ubuntu-benchmark.yaml
ARBUTUS_USER_DATA=

# Optional override. The default is benchmark-runner-ssh.
ARBUTUS_SECURITY_GROUP=benchmark-runner-ssh
